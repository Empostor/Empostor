  "DarkTokens": {
    "--bg": "#282828",
    "--s": "#3C3836",
    "--b": "#504945",
    "--t": "#EBDBB2",
    "--m": "#A89984",
    "--a": "#FE8019",
    "--g": "#B8BB26",
    "--y": "#FABD2F",
    "--r": "#FB4934",
    "--p": "#D3869B",
    "--o": "#D65D0E",
    "--field": "#1D2021",
    "--hover": "rgba(235,219,178,.06)",
    "--on-a": "#282828"
  },
  "CustomCss": "body{letter-spacing:.1px}\nh2{padding-bottom:8px;border-bottom:2px solid var(--b)}\n.form,.sc,.ig,table{border-radius:6px;border-width:2px}\n.ni{border-radius:0 8px 8px 0}\n.ni.active{font-weight:700}\nbutton.bp,button.bd,button.bw,button.bsm{border-radius:6px;font-weight:700;text-transform:none}\ninput,select,textarea{border-radius:6px;border-width:2px}\nth{font-weight:700;letter-spacing:.6px}\n.badge{border-radius:6px}\n.code{font-weight:700}"
}
