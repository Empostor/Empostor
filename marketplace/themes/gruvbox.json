{
  "Id": "gruvbox",
  "Name": "Gruvbox",
  "Extends": null,
  "Tokens": {
    "--bg": "#FBF1C7",
    "--s": "#F2E5BC",
    "--b": "#E0CFA0",
    "--t": "#3C3836",
    "--m": "#7C6F64",
    "--a": "#AF3A03",
    "--g": "#79740E",
    "--y": "#B57614",
    "--r": "#9D0006",
    "--p": "#8F3F71",
    "--o": "#D65D0E",
    "--field": "#FFFBF0",
    "--hover": "rgba(60,56,54,.06)",
    "--on-a": "#FBF1C7"
